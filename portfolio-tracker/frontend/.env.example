VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (API routes). Used for Google Places autocomplete on the
# trip destination field. Needs the Places API (New) enabled + billing.
# Never expose this in the client bundle.
# Either name works (GOOGLE_PLACES_API_KEY is accepted as an alias).
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
