VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Only needed for the future Capacitor (iOS) build: since a native app bundle has
# no real web origin, relative /api/... calls (see lib/api.ts) need an absolute
# base URL to reach the deployed backend. Leave unset for the site/PWA — apiFetch
# already defaults to '' (same-origin) when this isn't set.
# VITE_API_BASE_URL=https://arvo.app

# Server-side only (API routes). Used for Google Places autocomplete on the
# trip destination field. Needs the Places API (New) enabled + billing.
# Never expose this in the client bundle.
# Either name works (GOOGLE_PLACES_API_KEY is accepted as an alias).
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
